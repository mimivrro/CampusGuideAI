# Render Backend URL for API Requests (HTTP / HTTPS)
# Example: https://campusguide-ai.onrender.com
VITE_API_URL=https://your-render-backend.onrender.com

# Render Backend URL for Real-Time Audio WebSocket (WS / WSS)
