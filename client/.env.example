# ═════════════════════════════════════════════════════════════════════════════
# CampusGuide AI — Frontend Environment Template (Vercel & Local)
# ═════════════════════════════════════════════════════════════════════════════

# Render Backend URL (HTTP/HTTPS)
# Set this single variable in your Vercel project Environment Variables settings:
VITE_API_URL=https://your-render-backend.onrender.com

# (Optional) Override WebSocket URL if backend is on a separate domain.
# Left empty by default since single Render component automatically converts https:// -> wss://
VITE_WS_URL=
